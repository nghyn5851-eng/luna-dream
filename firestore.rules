rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Nhẫn tinh tú', 'Dây chuyền', 'Charm hành tinh'] &&
             data.imageUrl is string &&
             data.description is string;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 &&
             data.role in ['customer', 'admin'];
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list &&
             data.totalAmount is number &&
             data.customerInfo is map;
    }

    function isValidSettings(data) {
      return data.heroTitle is string &&
             data.heroSubtitle is string &&
             data.heroImage is string;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        incoming().role == 'customer' || 
        request.auth.token.email == 'nghyn5851@gmail.com'
      ) && isValidUser(incoming());
      allow update: if (isOwner(userId) && (
        incoming().role == existing().role ||
        request.auth.token.email == 'nghyn5851@gmail.com'
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }
  }
}
