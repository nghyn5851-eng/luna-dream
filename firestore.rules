rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() > 0 &&
             data.imageUrl is string &&
             data.description is string &&
             data.stock is number && data.stock >= 0 &&
             (data.createdAt == null || data.createdAt is string) &&
             (data.updatedAt == null || data.updatedAt is string);
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 &&
             data.role in ['customer', 'admin'] &&
             data.fullName is string;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list &&
             data.totalAmount is number &&
             data.status in ['Processing', 'Shipped', 'Delivered', 'Cancelled'] &&
             data.customerInfo is map;
    }

    function isValidSettings(data) {
      return data.heroTitle is string &&
             data.heroSubtitle is string &&
             data.heroImage is string &&
             data.philosophyTitle is string &&
             data.philosophyText is string &&
             data.contactEmail is string &&
             data.contactPhone is string &&
             data.contactAddress is string;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (incoming().role == 'customer' || (incoming().role == 'admin' && isAdmin())) && isValidUser(incoming());
      allow update: if (isOwner(userId) && incoming().role == existing().role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }
  }
}
